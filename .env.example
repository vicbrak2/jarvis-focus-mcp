PORT=8000

# Base URL of the Jarvis FOCUS OS REST API this server wraps.
JARVIS_BASE_URL=https://jarvis-focus-os-production.up.railway.app

# Required bearer token clients must send as `Authorization: Bearer <token>`.
# Jarvis FOCUS OS itself has no auth, so this is the only thing protecting
# the user's real tasks once this server is reachable at a public URL.
# Leave unset to run without auth (not recommended for a public deployment).
MCP_AUTH_TOKEN=
